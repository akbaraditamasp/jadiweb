      {{-- ================================================================
           HOW IT WORKS
           ================================================================ --}}
      <section id="cara" class="section" aria-label="Cara kerja - 3 langkah dari konsultasi sampai website live">
        <div class="container">
          <div style="text-align:center;max-width:620px;margin:0 auto 60px">
            <div class="reveal"><div class="eyebrow">Cara kerja</div></div>
            <div class="reveal" data-delay="60">
              <h2 class="sec-h2" style="margin-top:14px">Prosesnya simpel. Beneran.</h2>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:26px" class="step-grid">

            <div class="reveal" data-delay="0">
              <div>
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
                  <span class="step-num is-ai">01</span>
                  <span class="step-rule"></span>
                </div>
                <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
                  <i data-lucide="message-circle" style="width:19px;height:19px;color:var(--teal)"></i>
                  <h3 style="font:var(--text-h4)">Konsultasi</h3>
                </div>
                <p style="font-size:14.5px;line-height:1.6;color:var(--fg2)">Ceritain bisnis lo ke tim kami via WhatsApp atau Telepon. Gratis, tanpa pressure, nggak butuh ngerti teknis.</p>
                <a href="https://wa.me/6281271762774?text=Halo+JadiWeb%2C+saya+mau+konsultasi+bikin+website" class="btn btn-ghost" style="margin-top:12px;padding:8px 12px;font-size:13.5px" target="_blank" rel="noopener">
                  Mulai konsultasi →
                </a>
              </div>
            </div>

            <div class="reveal" data-delay="100">
              <div>
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
                  <span class="step-num">02</span>
                  <span class="step-rule"></span>
                </div>
                <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
                  <i data-lucide="hammer" style="width:19px;height:19px;color:var(--fg2)"></i>
                  <h3 style="font:var(--text-h4)">Pengerjaan</h3>
                </div>
                <p style="font-size:14.5px;line-height:1.6;color:var(--fg2)">Begitu deal, kami langsung kerjakan. Desain, domain, hosting, CMS & SEO - semua kami urus.</p>
              </div>
            </div>

            <div class="reveal" data-delay="200">
              <div>
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
                  <span class="step-num">03</span>
                  <span class="step-rule"></span>
                </div>
                <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
                  <i data-lucide="rocket" style="width:19px;height:19px;color:var(--fg2)"></i>
                  <h3 style="font:var(--text-h4)">Website Lo Live</h3>
                </div>
                <p style="font-size:14.5px;line-height:1.6;color:var(--fg2)">Dalam 2 hari kerja, website sudah online. Review, revisi kalau perlu, selesai.</p>
              </div>
            </div>

          </div>
        </div>
      </section>

      {{-- ================================================================
           PRICING (sarcastic 3-col)
           ================================================================ --}}
      <section id="harga" class="section" aria-label="Harga - Rp 2.490.000 per tahun, all-inclusive" style="background:var(--mist)">
        <div class="container">
          <div style="text-align:center;max-width:640px;margin:0 auto 64px">
