              <p style="font:var(--text-lead);color:var(--fg2);margin-top:14px">Nggak murahan, nggak ribet. Pas di tengah, persis yang bisnis lo butuh.</p>
            </div>
          </div>

          <div class="reveal" data-delay="120">
            <div class="price-grid">

              {{-- Dead left --}}
              <div class="price-col dead">
                <div class="price-tag-dead">Yang Murahan</div>
                <div class="price-quote">"Mulai 500 ribu!"</div>
                <div style="display:flex;flex-direction:column;margin-top:auto">
                  @each(f in ['Desain template, tinggal ganti teks', 'Revisi terbatas, lebih bayar lagi', 'Nggak ada SEO', 'Selesai kapan? Nunggu antrian', 'Kalau ada masalah susah dihubungi'])
                    <div class="price-feat struck">
                      <i data-lucide="x" style="width:16px;height:16px;color:var(--fg4)"></i>
                      <span class="ft">{{ f }}</span>
                    </div>
                  @end
                </div>
                <div style="margin-top:22px">
                  <button class="btn" disabled style="width:100%;background:var(--cloud);color:var(--fg4);cursor:not-allowed">Bukan ini</button>
                </div>
              </div>

              {{-- Live center --}}
              <div class="price-col live">
                <div class="price-pattern"></div>
                <div style="position:relative">
                  <span class="chip chip-solid">
                    <i data-lucide="sparkles"></i>
                    JadiWeb · Recommended
                  </span>
                  <div style="margin-top:18px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
                    <span style="font-family:var(--font-display);font-weight:800;font-size:42px;letter-spacing:-.03em;color:#fff">Rp 2.490.000</span>
                    <span style="font-size:15px;font-weight:600;color:var(--teal-300)">/tahun</span>
                  </div>
                  <p style="font-size:13.5px;color:rgba(234,240,238,.65);margin-top:6px">Kurang dari Rp 210.000/bulan. Tanpa biaya tersembunyi.</p>
                  <div style="height:1px;background:rgba(255,255,255,.12);margin:22px 0 6px"></div>
                  @each(f in ['Domain (.com atau .id)', 'Hosting 1 tahun', 'CMS - Bisa update konten sendiri', 'Full custom design', 'Optimasi SEO', 'Jadi dalam 2 hari kerja'])
                    <div class="price-live-feat">
                      <i data-lucide="check"></i>
                      {{ f }}
                    </div>
                  @end
                  <div style="margin-top:24px">
                    <a href="https://wa.me/6281271762774?text=Halo+JadiWeb%2C+saya+mau+jadiin+website+bisnis+saya" class="btn btn-primary btn-lg btn-block" target="_blank" rel="noopener">
                      Oke, Jadiin
                      <i data-lucide="arrow-right"></i>
                    </a>
                  </div>
                </div>
              </div>

              {{-- Dead right --}}
              <div class="price-col dead">
                <div class="price-tag-dead">Yang Over-Engineered</div>
                <div class="price-quote">"Kami butuh discovery session dulu."</div>
                <div style="display:flex;flex-direction:column;margin-top:auto">
                  @each(f in ['Brief 20 halaman sebelum mulai', 'Timeline berbulan-bulan', 'Revisi masuk scope tersendiri', 'Harga? Tunggu proposal', 'Hasilnya keren, tapi lo nggak butuh separuhnya'])
                    <div class="price-feat struck">
                      <i data-lucide="x" style="width:16px;height:16px;color:var(--fg4)"></i>
                      <span class="ft">{{ f }}</span>
                    </div>
                  @end
                </div>
                <div style="margin-top:22px">
                  <button class="btn" disabled style="width:100%;background:var(--cloud);color:var(--fg4);cursor:not-allowed">Bukan ini</button>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>

      {{-- ================================================================
           FAQ
           ================================================================ --}}
      <section id="faq" class="section" aria-label="FAQ - Pertanyaan umum tentang JadiWeb">
        <div class="container" style="max-width:800px">
          <div style="text-align:center;margin-bottom:48px">
            <div class="reveal"><div class="eyebrow">FAQ</div></div>
            <div class="reveal" data-delay="60">
              <h2 class="sec-h2" style="margin-top:14px">Masih ada yang bikin ragu?</h2>
            </div>
          </div>

          @let(faqs = [
            { q: '"Bisnis saya masih kecil, belum butuh website."', a: 'Justru sekarang waktu yang tepat. Bangun kredibilitas sebelum bisnis lo besar, biar dari awal sudah kelihatan serius dan profesional.' },
            { q: '"Mahal nggak?"', a: 'Rp 2.490.000 per tahun, sudah termasuk semuanya. Kurang dari Rp 210.000 per bulan dan nggak ada biaya tersembunyi.' },
            { q: '"Prosesnya lama nggak?"', a: '2 hari kerja. Bukan minggu, bukan bulan. Lo isi brief, kami langsung kerjakan.' },
            { q: '"Saya nggak ngerti soal website sama sekali."', a: 'Nggak perlu ngerti. Kami urus semuanya dari awal sampai live. Cukup kasih info bisnis lo, sisanya urusan kami.' }
          ])

          @each((faq, i) in faqs)
            <div class="reveal faq-item" data-delay="{{ i * 50 }}">
              <div class="faq-q" @click="toggleFaq({{ i }})">
                <span>
                  <span class="qmark">{{ i < 9 ? '0' + (i + 1) : (i + 1) }}</span>{{ faq.q }}
                </span>
                <span class="faq-icon" x-text="faqOpen === {{ i }} ? '−' : '+'"></span>
              </div>
              <p class="faq-a" x-show="faqOpen === {{ i }}" x-transition.duration.300ms>{{ faq.a }}</p>
            </div>
          @end

        </div>
      </section>

      {{-- ================================================================
           FINAL CTA (teal band)
           ================================================================ --}}
      <section class="section cta-band" aria-label="Call to action - Mulai buat website bisnis lo sekarang">
